# =============================================================================
# Made Easy Educational Consultancy platform — environment configuration
#
# Copy to .env and fill in. .env is gitignored: never commit real secrets.
# docker compose reads this same file (for container env AND ${VAR} substitution
# in docker-compose.yml), so there is only one place to configure the stack.
# Values marked PRODUCTION: change them on the VPS. README "Production
# environment variables" lists every one that must be real before go-live.
# =============================================================================

# PRODUCTION (VPS only, never locally): use the production overrides.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

APP_NAME="Made Easy"
# PRODUCTION: production
APP_ENV=local
# Generate with: docker compose run --rm app php artisan key:generate --show
# Changing it later: follow README "Rotating APP_KEY" (PINs depend on it).
APP_KEY=
# Old key(s), comma-separated, ONLY during a key rotation (README).
APP_PREVIOUS_KEYS=
# PRODUCTION: false
APP_DEBUG=true
# PRODUCTION: https://your-real-domain.com (must match SITE_ADDRESS below)
APP_URL=https://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs go to stderr so `docker compose logs app` shows them.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# PRODUCTION: warning
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Web server (Caddy)
# -----------------------------------------------------------------------------
# Domain(s) Caddy serves and gets certificates for. "localhost" uses Caddy's
# internal CA (self-signed; your browser will warn).
# PRODUCTION: madeeasy.example.com, www.madeeasy.example.com
SITE_ADDRESS=localhost
# Let's Encrypt account / expiry-notice email.
ACME_EMAIL=admin@example.com
# Host ports published by Caddy (change locally if 80/443 are taken).
HTTP_PORT=80
HTTPS_PORT=443
# HSTS (seconds browsers must use HTTPS only). 0 = off. PRODUCTION: leave 0
# until HTTPS works on the real domain, then 31536000 (GO-LIVE.md).
HSTS_MAX_AGE=0

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16, the "db" service)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=madeeasy
DB_USERNAME=madeeasy
# PRODUCTION: a long random password (e.g. `openssl rand -base64 32`)
DB_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Sessions, cache, queue: all database-backed (no Redis at launch)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# "local" = storage/app/private. Uploads must never go to a public disk.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------------------------------------------------------
# Mail (SMTP)
# -----------------------------------------------------------------------------
# "log" writes emails to the log locally. PRODUCTION: smtp
MAIL_MAILER=log
# "smtps" for implicit TLS on port 465, leave null for STARTTLS on 587.
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Paystack
# -----------------------------------------------------------------------------
# Get these from the Paystack Dashboard -> Settings -> API Keys & Webhooks
# (https://dashboard.paystack.com/#/settings/developers).
# Use the pk_test_/sk_test_ keys locally and pk_live_/sk_live_ in production.
# The secret key is server-side only; never expose it to the browser.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Webhook URL to enter in the Paystack dashboard: https://<your-domain>/webhooks/paystack
# (signed with PAYSTACK_SECRET_KEY; requests with a bad signature get a 401).

# Also email every staff/admin when a Paystack charge can't be applied
# automatically (amount mismatch, order no longer payable). They always get a
# back-office notification.
EMAIL_STAFF_ON_PAYMENT_REVIEW=true

# -----------------------------------------------------------------------------
# Initial admin account (php artisan db:seed)
# -----------------------------------------------------------------------------
# Locally the password falls back to "password" if left blank.
# PRODUCTION: required. The seeder refuses to run without it.
SEED_ADMIN_NAME="Made Easy Admin"
SEED_ADMIN_EMAIL=admin@madeeasy.test
SEED_ADMIN_PASSWORD=

# Public contact details (Contact page, footer, customer emails). Placeholders:
# replace with the client's real details before go-live.
CONTACT_BUSINESS_NAME="Made Easy Educational Consultancy"
CONTACT_PHONE="+234 800 000 0000"
CONTACT_WHATSAPP="+234 800 000 0000"
CONTACT_EMAIL=hello@madeeasy.example
CONTACT_ADDRESS="Office address to be confirmed"
CONTACT_HOURS="Monday – Saturday, 9am – 5pm"

# Max size (KB) of each file uploaded on a service request form.
UPLOAD_MAX_KILOBYTES=5120

# Also email every staff/admin when a customer responds to "needs action"
# (they always get a back-office notification).
EMAIL_STAFF_ON_CUSTOMER_RESPONSE=false

# Minutes of inactivity after which a guest's "Track your request" access ends
# and they must look the order up again (protects shared phones).
GUEST_TRACKING_IDLE_MINUTES=30

# -----------------------------------------------------------------------------
# Result checker PINs
# -----------------------------------------------------------------------------
# DEFAULT low-stock threshold: a service's PIN stock counts as "low" at or below
# this many available PINs, unless the service sets its own threshold (admin →
# Services → edit the result checker). Staff get a bell + email alert once when
# stock falls to its threshold and once when it runs out.
PIN_LOW_STOCK_THRESHOLD=20
# Most PINs a customer can buy in one order.
PIN_MAX_QUANTITY_PER_ORDER=10
# Also email every staff/admin when a paid order is short of PINs and needs
# manual fulfilment (they always get a back-office notification).
EMAIL_STAFF_ON_PIN_SHORTFALL=true

# -----------------------------------------------------------------------------
# Consultation bookings (/book-consultation)
# -----------------------------------------------------------------------------
# Timezone slot times are entered and shown in.
CONSULTATION_TIMEZONE=Africa/Lagos
# How long a chosen time is held for a customer who hasn't paid yet.
CONSULTATION_HOLD_MINUTES=30
# Customers can't book a time starting sooner than this.
CONSULTATION_MIN_NOTICE_MINUTES=60
# How far ahead the booking page shows times.
CONSULTATION_BOOKING_WINDOW_DAYS=60

# -----------------------------------------------------------------------------
# Updates / blog (/updates)
# -----------------------------------------------------------------------------
# Timezone publish dates are entered and shown in.
BLOG_TIMEZONE=Africa/Lagos
# Max size of a post image (featured or in the body). JPEG, PNG or WebP only.
BLOG_IMAGE_MAX_KILOBYTES=2048

# -----------------------------------------------------------------------------
# Backups (docker-compose.prod.yml "backup" service; README "Backups")
# -----------------------------------------------------------------------------
# age PUBLIC key(s), space-separated ("age1..."). Generate the pair OFF the
# server: `age-keygen -o madeeasy-backup-key.txt`. Keep the private key file
# offline; only the public key goes here. Required: the service won't start without it.
BACKUP_AGE_RECIPIENTS=
# Cron schedule, in BACKUP_TZ.
BACKUP_SCHEDULE="30 2 * * *"
BACKUP_TZ=Africa/Lagos
# Where copies go: scp | s3 | local (local = this server only, not a real backup).
BACKUP_TARGET=local
# Encrypted copies also kept on the server (backups volume) for this many days.
BACKUP_KEEP_LOCAL_DAYS=7
# BACKUP_TARGET=scp: user@host:/path, plus id_ed25519 + known_hosts in BACKUP_SSH_DIR.
BACKUP_SCP_DESTINATION=
BACKUP_SCP_PORT=22
BACKUP_SSH_DIR=./backup-ssh
# BACKUP_TARGET=s3 (any S3-compatible storage). Leave ENDPOINT empty for AWS itself.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=madeeasy
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

VITE_APP_NAME="${APP_NAME}"
