# =============================================================================
# Made Easy Educational Consultancy platform — environment configuration
#
# Copy to .env and fill in. .env is gitignored: never commit real secrets.
# docker compose reads this same file (for container env AND ${VAR} substitution
# in docker-compose.yml), so there is only one place to configure the stack.
# Values marked PRODUCTION: change them on the VPS.
# =============================================================================

APP_NAME="Made Easy"
# PRODUCTION: production
APP_ENV=local
# Generate with: docker compose run --rm app php artisan key:generate --show
APP_KEY=
# PRODUCTION: false
APP_DEBUG=true
# PRODUCTION: https://your-real-domain.com (must match SITE_ADDRESS below)
APP_URL=https://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs go to stderr so `docker compose logs app` shows them.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# PRODUCTION: warning
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Web server (Caddy)
# -----------------------------------------------------------------------------
# Domain(s) Caddy serves and gets certificates for. "localhost" uses Caddy's
# internal CA (self-signed; your browser will warn).
# PRODUCTION: madeeasy.example.com, www.madeeasy.example.com
SITE_ADDRESS=localhost
# Let's Encrypt account / expiry-notice email.
ACME_EMAIL=admin@example.com
# Host ports published by Caddy (change locally if 80/443 are taken).
HTTP_PORT=80
HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16, the "db" service)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=madeeasy
DB_USERNAME=madeeasy
# PRODUCTION: a long random password (e.g. `openssl rand -base64 32`)
DB_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Sessions, cache, queue: all database-backed (no Redis at launch)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# "local" = storage/app/private. Uploads must never go to a public disk.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------------------------------------------------------
# Mail (SMTP)
# -----------------------------------------------------------------------------
# "log" writes emails to the log locally. PRODUCTION: smtp
MAIL_MAILER=log
# "smtps" for implicit TLS on port 465, leave null for STARTTLS on 587.
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Paystack
# -----------------------------------------------------------------------------
# Get these from the Paystack Dashboard -> Settings -> API Keys & Webhooks
# (https://dashboard.paystack.com/#/settings/developers).
# Use the pk_test_/sk_test_ keys locally and pk_live_/sk_live_ in production.
# The secret key is server-side only; never expose it to the browser.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# -----------------------------------------------------------------------------
# Initial admin account (php artisan db:seed)
# -----------------------------------------------------------------------------
# Locally the password falls back to "password" if left blank.
# PRODUCTION: required. The seeder refuses to run without it.
SEED_ADMIN_NAME="Made Easy Admin"
SEED_ADMIN_EMAIL=admin@madeeasy.test
SEED_ADMIN_PASSWORD=

# Public contact details (Contact page, footer, customer emails). Placeholders:
# replace with the client's real details before go-live.
CONTACT_BUSINESS_NAME="Made Easy Educational Consultancy"
CONTACT_PHONE="+234 800 000 0000"
CONTACT_WHATSAPP="+234 800 000 0000"
CONTACT_EMAIL=hello@madeeasy.example
CONTACT_ADDRESS="Office address to be confirmed"
CONTACT_HOURS="Monday – Saturday, 9am – 5pm"

# Max size (KB) of each file uploaded on a service request form.
UPLOAD_MAX_KILOBYTES=5120

# Also email every staff/admin when a customer responds to "needs action"
# (they always get a back-office notification).
EMAIL_STAFF_ON_CUSTOMER_RESPONSE=false

VITE_APP_NAME="${APP_NAME}"
